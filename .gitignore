# OS / editor cruft
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Dependencies / build output (belt-and-suspenders; app/ has its own too)
node_modules/
dist/
dist-ssr/
*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment / secrets (keep a committed .env.example for required keys)
.env
.env.*
!.env.example

# Raw downloaded font source (.ttf/zip) — app ships the derived woff2 in app/public/fonts/
Media/Fonts/

# Raw screenshot captures — README uses the compressed .webp versions
Media/screenshots/*.png

# Personal / scratch — kept local, not pushed
Features/
CLAUDE.md
CODE_TUTOR.md
TASKS.md

# Specs, design handoffs, and reference captures — kept local, not public
Specs/

# macOS Finder duplicates ("folder 2", "file 2.ext")
* 2/
* 2.*

# Local agent-guidance doc (Codex counterpart to CLAUDE.md, kept local)
AGENTS.md
