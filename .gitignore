# OS / editor cruft
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Dependencies / build output (belt-and-suspenders; app/ has its own too)
node_modules/
dist/
dist-ssr/
*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Raw downloaded font source (.ttf/zip) — app ships the derived woff2 in app/public/fonts/
Media/Fonts/

# Personal / scratch — kept local, not pushed
Features/
CLAUDE.md
CODE_TUTOR.md
TASKS.md

# Specs: track the spec + design handoff, ignore the cruft inside
Specs/**/*.zip
Specs/**/*.webloc
Specs/**/*.csv

# Local agent-guidance doc (Codex counterpart to CLAUDE.md, kept local)
AGENTS.md
